<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Attributes shared by every API level. Navigation-bar and cutout
         attributes live in values-v27 because they were added in API 27. -->
    <style name="Theme.AlexApps.Base" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.AlexApps" parent="Theme.AlexApps.Base">
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
